rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function admin(){ return signedIn() && request.auth.token.admin == true; }
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','university','major','cohort','bio','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      match /favorites/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    match /listings/{id} {
      allow read: if resource.data.status == 'active' || admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','ownerId','title','price','image','images','condition','school','distance','area','type','color','description','status','createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.type in ['sale','free','exchange']
        && (request.resource.data.type != 'free' || request.resource.data.price == 0)
        && request.resource.data.images is list && request.resource.data.images.size() > 0 && request.resource.data.images.size() <= 5;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
    match /offers/{id} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['buyerId','sellerId','listingId','price','message','status','createdAt'])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.price is number && request.resource.data.price >= 0
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'active';
    }
    match /{document=**} { allow read,write: if false; }
  }
}
