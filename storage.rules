rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{uid}/{file} {
      allow read: if folder in ['listings','avatars'];
      allow create: if folder in ['listings','avatars'] && request.auth != null && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if folder in ['listings','avatars'] && request.auth != null && request.auth.uid == uid;
    }
  }
}
